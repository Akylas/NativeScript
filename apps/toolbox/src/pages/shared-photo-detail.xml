<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo" class="page">
  <Page.actionBar>
    <ActionBar title="Photo" class="action-bar" />
  </Page.actionBar>

  <GridLayout rows="*,auto" backgroundColor="black">
    <GridLayout row="0" id="zoomHost" clipToBounds="true">
      <Image id="photo" stretch="aspectFit" />
    </GridLayout>
    <GridLayout row="1" columns="*,auto" backgroundColor="#202020" padding="10">
      <Label col="0" text="{{ info }}" color="white" verticalAlignment="center" />
      <Button col="1" text="Back" tap="{{ back }}" class="btn btn-primary" />
    </GridLayout>
  </GridLayout>
</Page>
